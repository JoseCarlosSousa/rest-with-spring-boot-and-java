	<queryString language="SQL">
		<![CDATA[SELECT id,
	author,
	launch_date AS launchDate,
	price,
	title
FROM spring_boot_starter_data_jpa.books b
JOIN spring_boot_starter_data_jpa.person_books pb ON pb.book_id = b.id 
WHERE pb.person_id = 1;]]>
	</queryString>
